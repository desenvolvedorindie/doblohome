{
  "name": "doblo-solar-expander",
  "version": "2.0.0",
  "description": "Visualizador 3D Interativo de Painéis Solares Retráteis para Fiat Doblò com Three.js e React",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:cutting": "vitest run tests/cuttingOptimizer.test.ts",
    "test:cutting:script": "npx vite-node tmp/scripts/test_cutting_plan_automated.ts",
    "test:combinations": "npx vite-node tmp/scripts/run_all_combinations.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
